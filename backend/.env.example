# 复制本文件为 333333330...env 后按需修改。

# 数据库连接串。留空则使用本地 SQLite 文件 lab_agent.db。
# 想用 pgvector 当向量库时，这里必须指向启用 pgvector 扩展的 PostgreSQL。
# PostgreSQL 生产示例：
#   postgresql+psycopg2://postgres:123456@127.0.0.1:5432/lab_agent
# MySQL 示例：mysql+pymysql://root:123456@127.0.0.1:3306/lab_agent
DATABASE_URL=

# JWT 密钥，生产环境请改成足够长的随机字符串。
JWT_SECRET_KEY=dev-only-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 大模型配置：OpenAI 兼容协议。
LLM_API_KEY=你的API密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# RAG 向量模型。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内网络建议使用 HuggingFace 镜像，避免模型下载失败。
HF_ENDPOINT=https://hf-mirror.com

# 文档切块与检索
CHUNK_SIZE=200
CHUNK_OVERLAP=40
RETRIEVAL_TOP_K=5
FINAL_CONTEXT_K=3
CONTEXT_WINDOW=1

# 向量库：auto / chroma / milvus / pgvector
VECTOR_BACKEND=auto
# 注意：Milvus Lite 不支持 Windows；Windows 上要用 Milvus 需通过 Docker 起 Milvus 服务。
MILVUS_LOCAL_URI=./data/milvus.db

# 混合检索与重排
HYBRID_SEARCH_ENABLED=true
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base

# Redis（可选，用于限流与缓存）
REDIS_URL=

# MCP（可选）
MCP_ENABLED=true
MCP_TRANSPORT=streamable_http
MCP_URL=http://127.0.0.1:8100/mcp
