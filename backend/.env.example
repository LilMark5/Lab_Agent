# 复制本文件为 .env 后按需修改。

# 数据库连接串。留空则使用本地 SQLite 文件 lab_agent.db。
# 想用 pgvector 当向量库时，这里必须指向启用 pgvector 扩展的 PostgreSQL。
# PostgreSQL 生产示例：
#   postgresql+psycopg2://postgres:123456@127.0.0.1:5432/lab_agent
# MySQL 示例：mysql+pymysql://root:123456@127.0.0.1:3306/lab_agent
DATABASE_URL=

# JWT 密钥，生产环境请改成足够长的随机字符串。
JWT_SECRET_KEY=dev-only-secret-key-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 大模型配置：OpenAI 兼容协议。
LLM_API_KEY=你的API密钥
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# RAGAS 评估裁判模型（可选）。评估可靠性取决于裁判比被测更强更稳定，
# 建议指向更强的模型（如 deepseek-reasoner）。留空则回退到被测模型。
JUDGE_MODEL=
JUDGE_API_KEY=
JUDGE_BASE_URL=

# RAG 向量模型。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内网络建议使用 HuggingFace 镜像，避免模型下载失败。
HF_ENDPOINT=https://hf-mirror.com

# 文档切块与检索
CHUNK_SIZE=200
CHUNK_OVERLAP=40
RETRIEVAL_TOP_K=5
FINAL_CONTEXT_K=3
CONTEXT_WINDOW=1

# 向量库：auto / chroma / milvus / pgvector
VECTOR_BACKEND=auto
# 注意：Milvus Lite 不支持 Windows；Windows 上要用 Milvus 需通过 Docker 起 Milvus 服务。
MILVUS_LOCAL_URI=./data/milvus.db

# 混合检索与重排
HYBRID_SEARCH_ENABLED=true
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base

# 查询改写（可选，需 LLM）：检索前把口语化问句改写成规范检索词。
QUERY_REWRITE_ENABLED=false

# Redis（可选，用于限流与缓存）
REDIS_URL=

# MCP（可选）
MCP_ENABLED=true
MCP_TRANSPORT=streamable_http
MCP_URL=http://127.0.0.1:8100/mcp

# LangGraph checkpointer 会话持久化。留空用本地 SQLite；
# 生产推荐 PostgreSQL（psycopg3 格式），与业务库同源、支持多实例。
# CHECKPOINT_DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5432/lab_agent

# Agent 工具调用健壮性：单次调用超时（秒）、失败重试次数。
TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_RETRIES=1

# 上下文窗口保护：送入 LLM 的消息 token 预算（不含 system prompt，字符/4 轻量估算）。
# 超预算时按 TRIM_STRATEGY 裁剪历史：
#   sliding_window=滑动窗口（默认，保留最新、丢最早）
#   summary=把丢掉的早期对话压成一条摘要占位
MAX_CONTEXT_TOKENS=4000
TRIM_STRATEGY=sliding_window
